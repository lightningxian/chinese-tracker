rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isActive() {
      return userDoc().data.get('active', true) == true;
    }

    function isAdmin() {
      return isSignedIn() && isActive() && userDoc().data.role == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && isActive() && userDoc().data.role == 'teacher';
    }

    // Raster images only: an SVG can carry scripts.
    function isImage() {
      return request.resource.contentType.matches('image/.*') &&
        request.resource.contentType != 'image/svg+xml';
    }

    match /ocr_uploads/{teacherId}/{fileName} {
      allow read: if isSignedIn() &&
        request.auth.uid == teacherId &&
        isTeacher();

      allow write: if isSignedIn() &&
        request.auth.uid == teacherId &&
        isTeacher() &&
        request.resource.size < 15 * 1024 * 1024;

      allow delete: if isSignedIn() &&
        request.auth.uid == teacherId &&
        isTeacher();
    }

    match /profile_photos/{userId}/{fileName} {
      allow read: if isSignedIn();

      allow write: if isSignedIn() &&
        (request.auth.uid == userId || isAdmin()) &&
        isImage() &&
        request.resource.size < 5 * 1024 * 1024;

      allow delete: if isSignedIn() &&
        (request.auth.uid == userId || isAdmin());
    }

    function isStaff() {
      return isAdmin() || isTeacher();
    }

    // Shared teaching materials. Staff upload; any signed-in user may read
    // (Firestore rules gate which materials are actually surfaced/published).
    match /materials/{ownerId}/{fileName} {
      allow read: if isSignedIn();

      allow write: if isSignedIn() &&
        isStaff() &&
        request.resource.size < 25 * 1024 * 1024;

      allow delete: if isSignedIn() && isStaff();
    }

    // Owner 2026-11-24: the PDF of an unfinished paper scan (admin only).
    // Like every isAdmin()/isStaff() rule here, it reads the user's profile
    // in Firestore: on live this needs the one-time cross-service grant
    // (docs/OWNER_PROCEDURES.md, "Storage rules that read Firestore").
    match /paper_drafts/{uid}/{fileName} {
      allow read, delete: if isAdmin();
      allow write: if isAdmin() &&
        request.resource.contentType == 'application/pdf' &&
        request.resource.size < 60 * 1024 * 1024;
    }

    // Owner 2026-11-26: a worksheet's answer-sheet PDF. It is the key, so
    // only admins read it (students and teachers never), PDF only.
    match /answer_sheets/{uid}/{fileName} {
      allow read, delete: if isAdmin();
      allow write: if isAdmin() &&
        request.auth.uid == uid &&
        request.resource.contentType == 'application/pdf' &&
        request.resource.size < 25 * 1024 * 1024;
    }

    // Owner 2026-11-26: the photo of a cash or transfer payment (receipt or
    // transfer screenshot), kept as documentation. Admins only; images only.
    match /payment_proofs/{invoiceId}/{fileName} {
      allow read, delete: if isAdmin();
      allow write: if isAdmin() && isImage() &&
        request.resource.size < 10 * 1024 * 1024;
    }

    // Question-bank media (images/audio per question). Staff write; signed-in read.
    // A paper's official recording may be up to 60 MB (Build 1B); every
    // other file (pictures) stays under 10 MB.
    match /question_bank_media/{ownerId}/{fileName} {
      allow read: if isSignedIn();

      allow write: if isSignedIn() &&
        isStaff() &&
        (request.resource.contentType.matches('audio/.*')
          ? request.resource.size < 60 * 1024 * 1024
          : request.resource.size < 10 * 1024 * 1024);

      allow delete: if isSignedIn() && isStaff();
    }
  }
}
