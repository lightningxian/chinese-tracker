rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Deactivated accounts keep their profile doc but lose every role-based
    // right. The app also signs them out (AuthService.signIn / init).
    function isActive() {
      return userDoc().data.get('active', true) == true;
    }

    function isTeacher() {
      return isSignedIn() &&
        hasUserProfile() &&
        isActive() &&
        userDoc().data.get('role', '') == 'teacher';
    }

    function isAdmin() {
      return isSignedIn() &&
        hasUserProfile() &&
        isActive() &&
        userDoc().data.get('role', '') == 'admin';
    }

    function isStaff() {
      return isTeacher() || isAdmin();
    }

    // Build 3: a self-registered student is `pending` until an admin
    // approves them (`rejected` when refused). Students made before Build 3
    // have no `status` and count as approved.
    function statusApproved(data) {
      return data.get('status', 'active') in ['active', ''];
    }

    function isStudent() {
      return isSignedIn() &&
        hasUserProfile() &&
        isActive() &&
        userDoc().data.get('role', 'student') == 'student' &&
        statusApproved(userDoc().data);
    }

    // Signed in and not a pending or rejected student. A pending student
    // reads only their own profile and the notifications addressed to them.
    // (No profile yet, e.g. the complete-profile step, counts as signed in.)
    function isApprovedUser() {
      return isSignedIn() &&
        (!hasUserProfile() || statusApproved(userDoc().data));
    }

    function isParent() {
      return isSignedIn() &&
        hasUserProfile() &&
        isActive() &&
        userDoc().data.get('role', '') == 'parent';
    }

    // The teacher a student registers under must be a real, active teacher
    // (the link code itself is checked by resolveLinkCode before sign-up;
    // this stops a profile written with a made-up or foreign teacherId).
    function isActiveTeacher(uid) {
      return uid is string && uid.size() > 0 &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.get('role', '') == 'teacher' &&
        get(/databases/$(database)/documents/users/$(uid)).data.get('active', true) == true;
    }

    // The voucher an invoice is linked to must belong to the invoiced student.
    function termBelongsTo(termId, studentId) {
      return exists(/databases/$(database)/documents/student_class_terms/$(termId)) &&
        get(/databases/$(database)/documents/student_class_terms/$(termId)).data.get('studentId', '') == studentId;
    }

    // True when the caller is a parent linked to the given studentId.
    function isParentOf(studentId) {
      return isParent() &&
        (studentId in userDoc().data.get('studentIds', []));
    }

    function sessionData(sessionId) {
      return get(/databases/$(database)/documents/class_sessions/$(sessionId)).data;
    }

    function sessionExists(sessionId) {
      return exists(/databases/$(database)/documents/class_sessions/$(sessionId));
    }

    function sessionIsOpen(sessionId) {
      return sessionExists(sessionId) &&
        sessionData(sessionId).get('isOpen', true) != false &&
        sessionData(sessionId).get('isConcluded', false) != true;
    }

    function hasJoinedSession(sessionId) {
      return exists(
        /databases/$(database)/documents/attendance/$(sessionId + '_' + request.auth.uid)
      );
    }

    function isStaffRole(role) {
      return role == 'teacher' || role == 'admin';
    }

    function userCanReadOther() {
      // Caller is reading someone else's profile — safe to get() the caller's doc.
      return isAdmin() ||
        (isTeacher() && resource.data.get('role', '') == 'student') ||
        (isStudent() && isStaffRole(resource.data.get('role', '')));
    }

    function selfUserCreateValid() {
      let data = request.resource.data;
      let role = data.get('role', '');
      // Teachers are created by admins only (adminUserCreateValid); anyone
      // could otherwise self-register as staff.
      return role in ['student', 'parent'] &&
        data.get('email', '') is string &&
        data.get('name', '') is string &&
        data.get('active', true) == true &&
        // Build 3: a student registers as `pending`, with no level (the
        // admin sets it at approval) and an optional teacher (a typed link
        // code; else the admin picks one).
        (role != 'student' || (
          data.get('status', '') == 'pending' &&
          (data.get('teacherId', '') == '' || isActiveTeacher(data.get('teacherId', ''))) &&
          data.get('level', '') == '' &&
          data.get('termSize', 0) in [8, 16] &&
          data.get('placementChoice', '') in ['hsk1', 'test'] &&
          data.get('placementTarget', '') is string &&
          data.get('placementResultCode', '') is string &&
          !('levels' in data) &&
          !('approvedBy' in data) &&
          !('placementDone' in data)
        )) &&
        (role != 'parent' || !('status' in data)) &&
        // Parents self-register with NO linked children. Linking is done only
        // by the linkChild Cloud Function (admin SDK), which verifies the child
        // access code server-side — so a parent can't link to an arbitrary
        // student by writing studentIds directly.
        (role != 'parent' || (
          data.get('studentIds', []) == [] &&
          data.get('teacherIds', []) == []
        ));
    }

    function selfUserUpdateValid() {
      let data = request.resource.data;
      let existing = resource.data;
      return data.role == existing.role &&
        data.email == existing.email &&
        data.get('active', true) == existing.get('active', true) &&
        data.get('teacherId', '') == existing.get('teacherId', '') &&
        // The child access code is set once (ensureParentCode) and never
        // changed by the student afterwards.
        (existing.get('parentCode', '') == '' ||
          data.get('parentCode', '') == existing.get('parentCode', '')) &&
        // Child links are managed only by the linkChild Cloud Function.
        data.get('studentIds', []) == existing.get('studentIds', []) &&
        data.get('teacherIds', []) == existing.get('teacherIds', []) &&
        // Build 2B: the HSK level is set by the admin (promotion), never by
        // the student.
        data.get('level', '') == existing.get('level', '') &&
        // Build 3: approval, the placement choice and a teacher's levels
        // are the admin's (decideRegistration, the user form).
        data.get('status', '') == existing.get('status', '') &&
        data.get('placementChoice', '') == existing.get('placementChoice', '') &&
        data.get('placementTarget', '') == existing.get('placementTarget', '') &&
        data.get('placementResultCode', '') == existing.get('placementResultCode', '') &&
        data.get('placementDone', false) == existing.get('placementDone', false) &&
        data.get('rejectReason', '') == existing.get('rejectReason', '') &&
        data.get('approvedBy', '') == existing.get('approvedBy', '') &&
        data.get('levels', []) == existing.get('levels', []);
    }

    function adminUserCreateValid() {
      let data = request.resource.data;
      return data.get('role', '') in ['teacher', 'student', 'admin', 'parent'] &&
        data.get('email', '') is string &&
        data.get('name', '') is string;
    }

    function notificationVisible() {
      let data = resource.data;
      let targetUser = data.get('userId', '');
      let audience = data.get('forRole', 'all');
      return (targetUser == '' || targetUser == request.auth.uid) && (
        (isAdmin() && (audience in ['admin', 'all'] || targetUser == request.auth.uid)) ||
        (isTeacher() && (audience in ['teacher', 'all'] || targetUser == request.auth.uid)) ||
        (isStudent() && (audience in ['student', 'all'] || targetUser == request.auth.uid)) ||
        (isParent() && (audience == 'all' || targetUser == request.auth.uid)) ||
        (!isAdmin() && !isTeacher() && !isStudent() && !isParent() && targetUser == request.auth.uid)
      );
    }

    function notificationMarkReadValid() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read']) &&
        request.resource.data.read == true;
    }

    // Build 2B: the student's level history (written by decidePromotion).
    match /users/{userId}/level_history/{entryId} {
      allow read: if isApprovedUser() &&
        (request.auth.uid == userId || isStaff() || isParentOf(userId));
      allow write: if false;
    }

    match /users/{userId} {
      // Self-read must NOT call get(users/$(uid)) — that recurses and denies
      // teacher/student profile loads (breaking test login after Auth succeeds).
      allow read: if isSignedIn() && request.auth.uid == userId;
      // NOTE: must not require `request.auth.uid != userId` here — Firestore
      // cannot prove that for collection queries (the caller's own doc could
      // match), which silently denies the role-filtered user list queries
      // used by the admin Users tab and teacher student lists.
      allow read: if isSignedIn() && userCanReadOther();
      // Parents may read the profiles of their linked children.
      allow read: if isParentOf(userId);
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && selfUserCreateValid()) ||
        (isAdmin() && adminUserCreateValid())
      );
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
          resource.data.get('active', true) == true &&
          selfUserUpdateValid()) ||
        isAdmin()
      );
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && notificationVisible();
      allow create: if isStaff();
      allow update: if isSignedIn() &&
        notificationVisible() &&
        notificationMarkReadValid();
      allow delete: if isAdmin();
    }

    match /class_sessions/{sessionId} {
      // Admin: all sessions. Teachers: own sessions. Students: their centre's.
      // Parents: sessions for any teacher linked to one of their children.
      allow read: if isAdmin() ||
        (isTeacher() && resource.data.get('teacherId', '') == request.auth.uid) ||
        // Owner 2026-11-23: a helper teacher reads the classes they help in.
        (isTeacher() && request.auth.uid in resource.data.get('coTeacherIds', [])) ||
        // Build 6: the centre's generated timetable is open to book.
        ((isStudent() || isParent()) && resource.data.get('generated', false) == true) ||
        (isStudent() &&
          resource.data.get('teacherId', '') != '' &&
          resource.data.get('teacherId', '') ==
            userDoc().data.get('teacherId', '')) ||
        (isParent() &&
          resource.data.get('teacherId', '') != '' &&
          resource.data.get('teacherId', '') in
            userDoc().data.get('teacherIds', []));
      // Build 6: a generated session (scheduleId) is written by functions.
      allow create: if isStaff() && request.resource.data.get('scheduleId', '') == '' &&
        request.resource.data.get('generated', false) != true &&
        request.resource.data.get('isConcluded', false) == false &&
        !request.resource.data.keys().hasAny(sessionFunctionFields());
      // Build 7: the session's life (check-in, close, cancel, substitute,
      // flags) is written only by functions.
      allow update: if isStaff() &&
        request.resource.data.get('scheduleId', '') == resource.data.get('scheduleId', '') &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(sessionFunctionFields().concat(['isConcluded', 'teacherId', 'generated']));
      allow delete: if isStaff() && resource.data.get('generated', false) != true &&
        resource.data.get('isConcluded', false) != true;
    }

    function sessionFunctionFields() {
      return ['status', 'checkInAt', 'lateMinutes', 'lateCheckIn', 'unclosed',
        'reminderSentAt', 'concludedAt', 'closedAt', 'cancelledAt', 'substituteFor',
        'bookedCount'];
    }

    // Build 7: a teacher asks the admin to change their schedule (the
    // function writes it; staff read; the admin resolves through a function).
    match /schedule_change_requests/{id} {
      allow read: if isAdmin() ||
        (isTeacher() && resource.data.get('teacherId', '') == request.auth.uid);
      allow write: if false;
    }
    // Build 8: the monthly centre report (functions write; admins read).
    match /reports/{month} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Build 7: the teacher's month counters (functions only).
    match /teacher_recaps/{id} {
      allow read: if isAdmin() ||
        (isTeacher() && resource.data.get('teacherId', '') == request.auth.uid);
      allow write: if false;
    }

    // Build 6: the weekly timetable, written only by saveSchedule (the
    // conflict check cannot be skipped). Locks are for the functions.
    match /schedules/{scheduleId} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    // Owner 2026-11-23: Indonesian holidays and days the admin closed
    // (written by importHolidays / setDayClosed), and announcements that
    // students, parents and teachers see at home. The admin writes
    // announcements directly; a closure announcement comes from setDayClosed.
    match /holidays/{date} {
      allow read: if isApprovedUser();
      allow write: if false;
    }
    // Owner 2026-11-24: one checklist per level (admin writes; the
    // functions copy each student's progress into promotion_progress).
    match /level_paths/{levelKey} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    // Owner 2026-11-24: unfinished paper scans (admin only, like scanning).
    match /paper_drafts/{id} {
      allow read, write: if isAdmin();
    }
    // Owner 2026-11-24: the waiting list of a full class (functions write).
    match /waitlist/{id} {
      allow read: if isApprovedUser() && (
        resource.data.get('studentId', '') == request.auth.uid ||
        isStaff() ||
        isParentOf(resource.data.get('studentId', ''))
      );
      allow write: if false;
    }
    match /announcements/{id} {
      allow read: if isApprovedUser();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasAll(['title', 'body', 'audience', 'toDate']) &&
        request.resource.data.title is string && request.resource.data.title.size() <= 120 &&
        request.resource.data.body is string && request.resource.data.body.size() <= 1000 &&
        request.resource.data.audience in ['all', 'students', 'teachers'];
      allow delete: if isAdmin();
    }
    match /schedule_locks/{lockId} {
      allow read, write: if false;
    }
    // Build 6: a teacher's days off (the teacher or an admin).
    match /teacher_days_off/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() ||
        (isTeacher() && request.resource.data.get('teacherId', '') == request.auth.uid);
      allow delete: if isAdmin() ||
        (isTeacher() && resource.data.get('teacherId', '') == request.auth.uid);
      allow update: if false;
    }

    match /lessons/{lessonId} {
      allow read: if isApprovedUser();
      allow write: if isStaff();
    }

    match /quizzes/{quizId} {
      allow read: if isApprovedUser();
      allow write: if isStaff();
    }

    // A package: questions live in the bank (bankSheets / bankQuestionIds),
    // none inside the document. Old-format exercises carry `questions`.
    function isPackageDoc(d) {
      return d.get('questions', []).size() == 0 &&
        (d.get('bankSheets', []).size() > 0 ||
          d.get('bankQuestionIds', []).size() > 0);
    }

    function ownsPackage(d) {
      return d.get('teacherId', '') == request.auth.uid && isPackageDoc(d);
    }

    match /exercises/{exerciseId} {
      allow read: if isApprovedUser();
      // Admins manage every exercise. Teachers (2026-11-13) create, edit
      // and delete their own packages (teacherId = their uid), never an
      // old-format exercise, and cannot hand a package to someone else.
      allow create: if isAdmin() ||
        (isTeacher() && ownsPackage(request.resource.data));
      allow update: if isAdmin() ||
        (isTeacher() && ownsPackage(resource.data) &&
          ownsPackage(request.resource.data));
      allow delete: if isAdmin() ||
        (isTeacher() && ownsPackage(resource.data));
    }

    match /exercise_assignments/{assignmentId} {
      allow read: if isSignedIn() && (
        isStaff() ||
        resource.data.get('studentId', '') == request.auth.uid
      );
      allow create, update, delete: if isStaff();
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (
        isStaff() ||
        resource.data.get('studentId', '') == request.auth.uid ||
        isParentOf(resource.data.get('studentId', ''))
      );
      // Online invoices are created by the createInvoice callable (admin SDK)
      // so the Snap token + order id are set atomically. Staff may record a
      // pending cash/transfer invoice directly; settling it is server-side
      // (markInvoicePaid callable), so update stays closed to clients.
      // Only the fields createManualInvoice writes; packages are 8 or 16
      // sessions (0 for a book / registration); a linked voucher must be the
      // student's own. markInvoicePaid credits `sessions`, so a client must
      // not be able to inflate it.
      allow create: if isStaff() &&
        request.resource.data.keys().hasOnly([
          'invoiceNumber', 'studentId', 'studentName', 'teacherId', 'item',
          'description', 'packageSize', 'priceItemId', 'kind', 'sessions',
          'amount', 'currency', 'status', 'paymentMethod', 'dueDate',
          'classTermId', 'createdBy', 'createdAt'
        ]) &&
        request.resource.data.get('status', '') == 'pending' &&
        request.resource.data.get('paymentMethod', '') == 'manual' &&
        request.resource.data.get('createdBy', '') == request.auth.uid &&
        request.resource.data.get('studentId', '') is string &&
        request.resource.data.get('amount', 0) is int &&
        request.resource.data.amount > 0 &&
        request.resource.data.get('kind', '') in ['sessions', 'book', 'registration', 'other'] &&
        request.resource.data.get('sessions', 0) in [0, 8, 16] &&
        request.resource.data.get('packageSize', 0) == request.resource.data.get('sessions', 0) &&
        (!('classTermId' in request.resource.data) ||
          termBelongsTo(request.resource.data.classTermId, request.resource.data.studentId));
      allow update: if false;
      allow delete: if isAdmin() && resource.data.get('status', '') == 'pending';
    }

    match /grades/{gradeId} {
      // Staff manage the gradebook; students see their own grades; parents see
      // their linked children's grades (read-only).
      allow read: if isSignedIn() && (
        isStaff() ||
        resource.data.get('studentId', '') == request.auth.uid ||
        isParentOf(resource.data.get('studentId', ''))
      );
      allow create, update, delete: if isStaff();
    }

    match /question_bank/{questionId} {
      // Scoped to staff: students never read raw answers.
      allow read: if isStaff();
      // Build 2B: admins manage the whole bank; a teacher types, pastes and
      // edits only the questions they created (createdBy = their uid, which
      // never changes), and may bump the usage counter of any question.
      allow create: if isAdmin() ||
        (isTeacher() && request.resource.data.get('createdBy', '') == request.auth.uid);
      allow update: if isAdmin() ||
        (isTeacher() &&
          resource.data.get('createdBy', '') == request.auth.uid &&
          request.resource.data.get('createdBy', '') == request.auth.uid) ||
        (isTeacher() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['usageCount', 'lastUsedAt']));
      allow delete: if isAdmin() ||
        (isTeacher() && resource.data.get('createdBy', '') == request.auth.uid);
    }

    // Exercise bundles ("Levels"): staff manage; students never read them,
    // they only see the assignments the app materialises from a level.
    match /exercise_levels/{levelId} {
      allow read, write: if isStaff();
    }

    // Prices are public: the landing page shows them before sign-in.
    match /settings/pricing {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      // Centre-wide settings are readable by any signed-in user (so gates can
      // be evaluated client-side); only admins may change them. Build 3:
      // `settings/rooms` {names} lists the rooms of the session forms.
      allow read: if isApprovedUser();
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      // Append-only ledger. Only admins read; all writes go through Cloud
      // Functions (admin SDK), so direct client writes are off.
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /materials/{materialId} {
      // Staff manage materials; signed-in users may read published ones.
      allow read: if isApprovedUser() && (
        isStaff() ||
        resource.data.get('status', 'draft') == 'published'
      );
      allow create, update, delete: if isStaff();
    }

    match /evaluations/{evaluationId} {
      // Staff write. Students read their own published evaluations; parents
      // read their linked child's published evaluations.
      allow read: if isSignedIn() && (
        isStaff() ||
        (resource.data.get('status', 'draft') == 'published' && (
          resource.data.get('studentId', '') == request.auth.uid ||
          isParentOf(resource.data.get('studentId', ''))
        ))
      );
      allow create, update, delete: if isStaff();
    }

    match /exercise_results/{resultId} {
      // Written only by the finishExercise function (admin SDK), which
      // checks the answers itself. No client write: a student could
      // otherwise post any score (closed 2026-11-12).
      allow read: if isApprovedUser() && (
        resource == null ||
        resource.data.studentId == request.auth.uid ||
        isStaff() ||
        isParentOf(resource.data.get('studentId', ''))
      );
    }

    match /student_progress/{progressId} {
      allow read: if isApprovedUser() && (
        resource == null ||
        resource.data.studentId == request.auth.uid ||
        isStaff() ||
        isParentOf(resource.data.get('studentId', ''))
      );
      allow create: if isApprovedUser() &&
        request.resource.data.studentId == request.auth.uid;
      // On update the existing doc must already belong to the caller, so a
      // student cannot overwrite another student's progress by guessing its id.
      allow update: if isApprovedUser() &&
        resource.data.studentId == request.auth.uid &&
        request.resource.data.studentId == request.auth.uid;
    }

    match /exercise_attempts/{attemptId} {
      // One-attempt exams: written only by startExercise / finishExercise.
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.studentId == request.auth.uid ||
        isStaff() ||
        isParentOf(resource.data.get('studentId', ''))
      );
    }

    match /quiz_results/{resultId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.studentId == request.auth.uid ||
        isStaff() ||
        isParentOf(resource.data.get('studentId', ''))
      );
      // Quizzes are no longer used (owner decision 2026-11-10); a client
      // could otherwise write any score here. Closed 2026-11-12.
      allow create: if false;
    }

    match /student_class_terms/{termId} {
      allow read: if isSignedIn() && (
        isStaff() ||
        resource.data.get('studentId', '') == request.auth.uid ||
        isParentOf(resource.data.get('studentId', ''))
      );
      allow create: if isStaff() &&
        request.resource.data.get('studentId', '') is string &&
        request.resource.data.get('packageSize', 0) is int &&
        request.resource.data.packageSize > 0 &&
        request.resource.data.get('sessionsRemaining', 0) == request.resource.data.packageSize &&
        request.resource.data.get('startDate', '') is string &&
        request.resource.data.get('deadlineDate', '') is string;
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    match /attendance/{recordId} {
      allow read: if isApprovedUser() && (
        resource == null ||
        isStaff() ||
        resource.data.get('studentId', '') == request.auth.uid ||
        isParentOf(resource.data.get('studentId', '')) ||
        hasJoinedSession(resource.data.get('sessionId', '')) ||
        (isStudent() && sessionIsOpen(resource.data.get('sessionId', '')))
      );
      // A student joins an open class under the id `sessionId_uid`, with
      // only the fields joinSession writes: no attendance status (the
      // teacher sets hadir / izin / alpa at conclude) and no voucher link.
      // Build 6: students book and cancel through bookSession /
      // cancelBooking (functions), which reserve a voucher session; staff
      // may still add a walk-in.
      allow create: if isSignedIn() && (
        (isStaff() &&
          request.resource.data.get('joinedBy', '') == 'teacher' &&
          request.resource.data.get('sessionCredited', false) == false)
      );
      // Build 7: the status, the voucher link and the booking are written
      // by closeSession / bookSession / cancelSession; staff keep notes.
      allow update: if isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes']);
      // Staff remove a walk-in before the close; a booking is cancelled
      // through the functions so its voucher session comes back.
      allow delete: if isStaff() && resource.data.get('booked', false) != true &&
        resource.data.get('sessionCredited', false) != true &&
        resource.data.get('closed', false) != true;
    }

    // Push tokens (web / Android devices that opted in on the profile tab).
    // A device may register, read and remove only its own user's tokens;
    // onNotificationCreated reads them with admin privileges.
    match /push_tokens/{token} {
      // `resource == null`: PushService reads its own token id to learn
      // whether this device is registered; a missing doc must read as
      // "not registered", not as an error.
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.get('uid', '') == request.auth.uid
      );
      allow delete: if isSignedIn() &&
        resource.data.get('uid', '') == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['uid', 'platform', 'updatedAt']) &&
        request.resource.data.get('uid', '') == request.auth.uid &&
        request.resource.data.get('platform', '') in ['web', 'android'];
      allow update: if isSignedIn() &&
        resource.data.get('uid', '') == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'platform', 'updatedAt']) &&
        request.resource.data.get('uid', '') == request.auth.uid &&
        request.resource.data.get('platform', '') in ['web', 'android'];
    }

    match /teacher_link_codes/{code} {
      // Students resolve codes via the resolveLinkCode Cloud Function (admin
      // privileges), so clients never read this collection directly. Teachers
      // may read their own code docs (and non-existent candidates) while
      // generating/rotating; reads of another teacher's code are denied, which
      // prevents anonymous or cross-teacher enumeration of codes -> teachers.
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.teacherId == request.auth.uid
      );
      // Only teachers mint codes; a student must not be able to create a code
      // that points at themselves.
      allow create: if isTeacher() &&
        request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() &&
        resource.data.teacherId == request.auth.uid &&
        request.resource.data.teacherId == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.teacherId == request.auth.uid;
    }

    match /teacher_link_state/{teacherId} {
      allow read, write: if isTeacher() && request.auth.uid == teacherId;
    }

    // ---- Supervised tests (PLAN.md §3, Build 1) ----
    // Formats and codes: admins write, staff read. Students never read them;
    // the startTest function sends what the start screen needs.
    match /test_formats/{formatId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() &&
        request.resource.data.get('parts', []) is list &&
        request.resource.data.get('passMark', 0) is number;
      allow delete: if isAdmin();
    }

    // The doc id is the code itself (upper case), so a duplicate code is a
    // write to an existing doc, which the app refuses in a transaction and
    // the rules refuse by keeping `code` equal to the id. Codes are never
    // deleted (results point at them); admins deactivate them instead.
    match /test_codes/{codeId} {
      allow read: if isStaff();
      allow create: if isAdmin() &&
        request.resource.data.get('code', '') == codeId &&
        request.resource.data.get('sheetKey', '') is string &&
        request.resource.data.get('sheetKey', '').size() > 0 &&
        request.resource.data.get('format', null) is map;
      allow update: if isAdmin() &&
        request.resource.data.get('code', '') == codeId &&
        request.resource.data.get('sheetKey', '') == resource.data.get('sheetKey', '');
      allow delete: if false;
    }

    // Sessions, attempts and results are written only by the functions
    // (openTestSession, startTest, submitTestPart, reportTestEvent,
    // closeTestSession, setTestResultValidity).
    match /test_sessions/{sessionId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Build 3: a visitor's attempt has `studentId: ''`, so only staff
    // read it (the key hash and the WhatsApp number are on it).
    match /test_attempts/{attemptId} {
      allow read: if isApprovedUser() && (
        resource == null ||
        (resource.data.studentId != '' && resource.data.studentId == request.auth.uid) ||
        isStaff()
      );
      allow write: if false;
    }

    // Build 5: the voucher ledger (purchase and expiry entries), written
    // only by functions. The student, staff and a linked parent read it.
    match /voucher_history/{entryId} {
      allow read: if isApprovedUser() && (
        isStaff() ||
        resource.data.get('studentId', '') == request.auth.uid ||
        isParentOf(resource.data.get('studentId', ''))
      );
      allow write: if false;
    }

    // Build 4: the progress summary of a student (functions write it). The
    // student, staff and a linked parent read it.
    match /progress_summary/{uid} {
      allow read: if isApprovedUser() &&
        (request.auth.uid == uid || isStaff() || isParentOf(uid));
      allow write: if false;
    }

    // Build 4: a teacher's follow-up note on a student's report. A teacher
    // writes notes only for their own students (users.teacherId), an admin
    // for anyone; the author or an admin edits or deletes it.
    function progressNoteShape(d) {
      return d.keys().hasOnly(['studentId', 'teacherId', 'teacherName', 'text',
          'createdAt', 'updatedAt']) &&
        d.get('studentId', '') is string && d.studentId.size() > 0 &&
        d.get('text', '') is string && d.text.size() > 0 && d.text.size() <= 500 &&
        d.get('teacherId', '') == request.auth.uid;
    }

    match /progress_notes/{noteId} {
      allow read: if isApprovedUser() && (
        isStaff() ||
        resource.data.get('studentId', '') == request.auth.uid ||
        isParentOf(resource.data.get('studentId', ''))
      );
      allow create: if progressNoteShape(request.resource.data) && (
        isAdmin() ||
        (isTeacher() &&
          get(/databases/$(database)/documents/users/$(request.resource.data.studentId))
            .data.get('teacherId', '') == request.auth.uid)
      );
      allow update: if (isAdmin() ||
          (isTeacher() && resource.data.get('teacherId', '') == request.auth.uid)) &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.get('text', '') is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.keys().hasOnly(['studentId', 'teacherId', 'teacherName',
          'text', 'createdAt', 'updatedAt']) &&
        request.resource.data.get('teacherId', '') == resource.data.get('teacherId', '');
      allow delete: if isAdmin() ||
        (isTeacher() && resource.data.get('teacherId', '') == request.auth.uid);
    }

    // Build 3: a visitor's placement result (name, WhatsApp, marks, result
    // code), written only by the placement functions. Staff read.
    match /placement_results/{resultId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Build 2B: the leaderboard of a test code, written only by the
    // onTestResultWritten trigger. Staff read every board; a student reads a
    // board only when their own result for that code exists (the result id
    // is `<codeId>_<uid>`). Entries carry the peer label, never the Latin
    // full name.
    match /leaderboards/{codeId} {
      allow read: if isStaff() || (isStudent() &&
        exists(/databases/$(database)/documents/test_results/$(codeId + '_' + request.auth.uid)));
      allow write: if false;
      match /entries/{uid} {
        allow read: if isStaff() || (isStudent() &&
          exists(/databases/$(database)/documents/test_results/$(codeId + '_' + request.auth.uid)));
        allow write: if false;
      }
    }

    // Build 2B: promotion recommendations (functions write; admins decide
    // through decidePromotion). Staff read; the student reads their own.
    match /level_promotions/{promotionId} {
      allow read: if isStaff() ||
        (isSignedIn() && resource.data.get('studentId', '') == request.auth.uid);
      allow write: if false;
    }

    // Build 2B: "2 of 3 codes passed" (written by the trigger).
    match /promotion_progress/{uid} {
      allow read: if isApprovedUser() &&
        (request.auth.uid == uid || isStaff() || isParentOf(uid));
      allow write: if false;
    }

    match /test_results/{resultId} {
      allow read: if isApprovedUser() && (
        resource == null ||
        resource.data.studentId == request.auth.uid ||
        isStaff() ||
        isParentOf(resource.data.get('studentId', ''))
      );
      allow write: if false;
    }

    // Build 2A: answers waiting for a teacher's mark. They carry the
    // accepted keys, so students and parents never read them; a teacher
    // reads only their own queue, admins all. Only Cloud Functions write
    // (markAnswer stores marks).
    match /marking_items/{itemId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isTeacher() && request.auth.uid in resource.data.get('teacherIds', []))
      );
      allow write: if false;
    }
  }
}
